# --- Doublespeak backend ---
LLM_PROVIDER=stub                 # stub | anthropic   (stub = no network, used by tests/eval)
ANTHROPIC_API_KEY=
DOUBLESPEAK_LLM_MODEL=claude-sonnet-5-5  # only used when LLM_PROVIDER=anthropic
DOUBLESPEAK_SIGNING_KEY=change-me-local  # HMAC key for verdict signatures (local only)
DOUBLESPEAK_DEBUG_SAVE=0                 # 1 = write analyzed audio to data/debug (never in demo)
ANTI_SPOOF_MODEL=                 # path to an ONNX anti-spoof model (v2), blank = disabled

# --- Gradium (red-team generator + spoken verdict) ---
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=                 # default attacker voice; create a clone in Gradium Studio
GRADIUM_BASE_URL=https://api.gradium.ai/api
ELEVENLABS_API_KEY=               # red-team only (tools/redteam); never used on the analysis path
ELEVENLABS_VOICE_ID=              # blank = stock voice; put a consenting teammate's clone here
# ELEVENLABS_MODEL=eleven_multilingual_v2
VOICESTUDIO_URL=http://127.0.0.1:3900   # local VoiceStudio app (AGPL-3.0, used over HTTP only); free, no credits
VOICESTUDIO_VOICE=                # a VoiceStudio profile id (teammate clone, with consent); blank = default voice
# VOICESTUDIO_MODEL=omnivoice

# --- Council (council/ask.py) ---
COUNCIL_ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
COUNCIL_OPENAI_MODEL=
XAI_API_KEY=
COUNCIL_XAI_MODEL=
GEMINI_API_KEY=
COUNCIL_GEMINI_MODEL=

# --- local neural voters (all on-device) ---
DOUBLESPEAK_WHISPER_MODEL=base.en        # faster-whisper size: tiny.en | base.en | small.en
HF_SPOOF_MODEL=garystafford/wav2vec2-deepfake-voice-detector   # T-010 pick: Apache-2.0, trained on ElevenLabs/Kokoro/Hume (not In-the-Wild); ~0.4 s per 10 s clip on CPU
# ANTI_SPOOF_MODEL=models/antispoof.onnx
# LLM_PROVIDER=ollama             # local 3B scam-talk judge (ollama serve; ollama pull llama3.2:3b). Set in .env for the demo.
# DOUBLESPEAK_LLM_MAX_WORDS=120          # transcript cap sent to the local LLM (keeps latency < 3 s)
# DOUBLESPEAK_WARMUP=0                   # disable startup model warm-up
OLLAMA_MODEL=qwen2.5:3b            # T-018: beat llama3.2:3b on tier accuracy (1.00 vs 0.78) at p95 0.9 s; ollama pull qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
# qwen3tts (local voice clone, red team only): pip install -U qwen-tts ; consenting teammate only
# QWEN3TTS_REF=data/ref/<teammate>.wav
# QWEN3TTS_REF_TEXT=the exact words spoken in that clip
# QWEN3TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base   # 1.7B-Base is better but ~3x slower; mps on Apple silicon

# --- API hardening (doublespeak/limits.py) ---
# DOUBLESPEAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000   # add `null` ONLY if you open index.html from file:// (any site can forge Origin: null)
# DOUBLESPEAK_ALLOWED_HOSTS=            # extra Host names (comma-separated); localhost, 127.0.0.1, [::1] always allowed
# DOUBLESPEAK_MAX_UPLOAD_MB=25
# DOUBLESPEAK_MAX_AUDIO_S=180
# DOUBLESPEAK_ANALYZE_TIMEOUT_S=60
# DOUBLESPEAK_OFFLINE=1            # after `make models`: models can never touch the network (HF offline); uncached ones degrade to n/a
# PELLA_MODEL=Sadanie/pellav2-audio-deepfake-detector   # Pellav2 voter (MIT; ~2.3 GB; run `make models` first). Weights are pinned + SHA-256 verified; never loaded unless they match.
# PELLA_DEVICE=auto                # auto (default): Apple MPS when available (~0.15 s per vote), else cpu (~1.6 s); cpu forces CPU
# PELLA_MAX_WINDOWS=3              # at most this many 4 s windows per call

# --- opt-in encrypted alert history (T-016); off by default. Key lives in the OS keychain, never on disk ---
# DOUBLESPEAK_HISTORY=1                  # enable: stores tier, p_ai, p_scam, thresholds_version, top-3 tell names. No audio/transcript/evidence
# DOUBLESPEAK_DATA_DIR=                  # default <repo>/data/history (dir 0700, file 0600)

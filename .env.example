# DoubleSpeak environment (optional). Copy to .env and adjust if needed.
# These are enforced in code too; listed here for visibility.

# Force fully-offline ML operation.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Where encrypted data and model weights live (optional overrides).
# DOUBLESPEAK_DATA_DIR=./data
# DOUBLESPEAK_MODELS_DIR=./models
